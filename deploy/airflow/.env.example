# Copiar a .env (chmod 600) y completar. .env NO va al repo: es público.

# uid del usuario de servicio `tilegen` en el host:   id -u tilegen
AIRFLOW_UID=
# gid del grupo docker del host:                       getent group docker | cut -d: -f3
DOCKER_GID=

# Generar cada uno con:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
JWT_SECRET=
# Este con:  python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=

# Primer usuario admin de la interfaz (los demás se crean desde ahí).
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Directorio en el HOST con las credenciales (dueño tilegen, chmod 700):
#   cdsapirc       copia de ~/.cdsapirc   (CDS / ERA5)
#   netrc          copia de ~/.netrc      (EDH; solo la entrada de earthdatahub)
#   clickup.token  token del aviso a ClickUp
TILEGEN_SECRETS_DIR=/home/tilegen/secrets

# Imagen inicial. Después se cambia desde la interfaz (Admin > Variables).
TILEGEN_IMAGE=tilegen:v0.5.0

AIRFLOW_PORT=8080
